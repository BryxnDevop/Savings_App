# Servidor solamente. Copia Connect > Session pooler > URI de tu proyecto.
# Sustituye la contraseña por la de la base (codifica caracteres especiales).
DATABASE_URL=
# Opcional: certificado raíz descargado de Database Settings, si TLS lo requiere.
DB_SSL_CA_FILE=
APP_ORIGIN=http://localhost:4173
PORT=4173
APP_TIME_ZONE=America/Santo_Domingo
# npm run setup genera esta clave. Conserva la anterior al migrar Gmail.
MAIL_ENCRYPTION_KEY=
# Vercel: copia estas variables al panel, no subas tu archivo .env.
# PEM del certificado de Supabase cuando la conexión requiera una CA propia.
DB_SSL_CA_CERT=
# Clave aleatoria de al menos 32 caracteres para /api/jobs.
CRON_SECRET=
# Web Push. Genera un par estable con: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# URL HTTPS de producción o un mailto: válido. En Vercel puede ser tu APP_ORIGIN.
VAPID_SUBJECT=
