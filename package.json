{
  "name": "ahorra-plus",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build && node scripts/build-pwa.mjs",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/configure.mjs",
    "test:db": "node --test tests/postgres.integration.mjs",
    "test:embedded": "node scripts/test-embedded.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:export": "node scripts/transfer-data.mjs export",
    "db:import": "node scripts/transfer-data.mjs import",
    "supabase": "supabase"
  },
  "dependencies": {
    "imapflow": "2.0.5",
    "mailparser": "3.9.28",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "supabase": "2.117.0",
    "vite": "8.3.0"
  }
}
